# Configurações da API de Embeddings
# Substitua pelos valores reais do seu provedor
BASE_URL=https://api.freellmapi.com/v1
API_KEY=coloque-sua-chave-aqui
MODEL=text-embedding-3-large

# Configuração do modelo de resposta
RESPONSE_MODEL=claude-opus-5-5

# Limite de busca
TOP_K=5
SIMILARITY_THRESHOLD=0.7